# PhaseGuard API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.

# ── Server ─────────────────────────────────────────────────────────────────────
WS_HOST=0.0.0.0
WS_PORT=8000
DEBUG=true
ENVIRONMENT=development   # development | staging | production

# ── Auth (CHANGE THIS in production!) ─────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_256_BIT_VALUE_IN_PRODUCTION
JWT_TTL_MINUTES=15

# ── Groq (STT + LLM) ──────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ── Tavily (web search for fact-checking) ─────────────────────────────────────
# Get your key at: https://tavily.com
TAVILY_API_KEY=tvly-...

# ── Exotel (real phone call ingestion — Indian CPaaS) ─────────────────────────
# Register at: https://exotel.com (no hardware required, pure API)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=

# ── Twilio (SMS fallback + Media Streams) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890

# ── MSG91 (family alert SMS — Indian provider, TRAI-registered) ───────────────
# Register at: https://msg91.com
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PHSGRD

# ── Bhashini (Government of India language AI) ────────────────────────────────
# Register at: https://bhashini.gov.in
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# ── Escalation destinations ────────────────────────────────────────────────────
CYBERCRIME_CELL_EMAIL=cybercrime@example.gov.in
ESCALATION_WEBHOOK_URL=https://hooks.slack.com/services/...
FAMILY_CONTACT_NUMBER=+919876543210

# ── TTS backend for scambaiter ─────────────────────────────────────────────────
# Options: gtts | elevenlabs | google | mock
TTS_BACKEND=gtts
TTS_LANGUAGE=hi

# ── ElevenLabs (optional, best TTS quality) ────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── DSP tuning (change only if you know what you're doing) ────────────────────
SAMPLE_RATE=16000
BISPECTRUM_WINDOW_SAMPLES=512  # DO NOT go below 512 — see dsp/bispectrum.py
BISPECTRUM_CADENCE_MS=150
TREMOR_WINDOW_SECONDS=1.5      # DO NOT go below 1.0 — see dsp/micro_tremor.py
TREMOR_CADENCE_SECONDS=1.5
PDI_THRESHOLD=0.6

# ── Ingestion mode ────────────────────────────────────────────────────────────
# Options: browser_mic | exotel | twilio
INGESTION_MODE=browser_mic

# ── Secret manager backend ────────────────────────────────────────────────────
# Options: env | doppler | infisical | gcp | aws
# Use "env" for local dev; use a real secret manager in production.
SECRET_MANAGER_BACKEND=env

# ── Worker pool ───────────────────────────────────────────────────────────────
EXECUTOR_WORKERS=4

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Leave blank for in-memory (single process). Set for multi-instance:
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0

# ── SMTP (for email escalation) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
