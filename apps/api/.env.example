# PhaseGuard API Configuration
# Copy this file to .env and fill in your actual API keys

# ── Groq (STT + LLM) ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Scambaiter API Keys (Separate from main system) ───────────────────────
SCAMBAITER_GROQ_API_KEY=your_scambaiter_groq_api_key_here
SCAMBAITER_TAVILY_API_KEY=your_scambaiter_tavily_api_key_here

# ── Tavily (AI Search - Primary Factcheck) ────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Fish Audio (TTS + Voice Cloning) ───────────────────────────────────────
FISH_API_KEY=your_fish_audio_api_key_here

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost/phaseguard

# ── JWT Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# ── Other Optional Keys ───────────────────────────────────────────────────
# NEWSAPI_KEY=your_newsapi_key_here
# SERPER_API_KEY=your_serper_api_key_here
# JINA_API_KEY=your_jina_api_key_here
